{
  "name": "capture",
  "version": "0.1.0",
  "description": "Capture — Arabic-first screen recording and editing workspace.",
  "homepage": "https://github.com/aiengmohamedtayal-netizen/amwaj",
  "author": {
    "name": "Capture Team",
    "email": "hello@capture.local"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aiengmohamedtayal-netizen/amwaj.git",
    "directory": "capture"
  },
  "private": true,
  "desktopName": "Capture",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.1.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.capture.desktop",
    "productName": "Capture",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "maintainer": "Capture Team <hello@capture.local>"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}

