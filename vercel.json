{
  "redirects": [
    {
      "source": "/admin/reviews/",
      "destination": "/admin/reviews",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin/reset-password",
      "destination": "/admin/reset-password/index.html"
    },
    {
      "source": "/admin/reset-password/:path*",
      "destination": "/admin/reset-password/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/post/index.html"
    }
  ]
}
